      },

      "lime": {
        "0": { "$value": "#f4fce3" },
        "1": { "$value": "#e9fac8" },
        "2": { "$value": "#d8f5a2" },
        "3": { "$value": "#c0eb75" },
        "4": { "$value": "#a9e34b" },
