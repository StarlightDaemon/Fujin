{
  "$description": "Fujin design token source of truth, in DTCG (Design Tokens Community Group) format. This file is AUTHORED BY HAND and is the only place design values are defined. Everything under dist/ is GENERATED from it by `npm run build` (Style Dictionary). Do not edit generated output; do not hand-copy values out of this file into a consuming repository — see CONSUMERS.md and AGENTS.md.",
  "$extensions": {
    "dev.starlightdaemon.fujin": {
      "name": "Fujin Design Tokens",
      "platform": "web+native",
      "defaultAccent": "violet",
      "accentOptions": ["violet", "indigo", "blue", "cyan", "teal", "green", "orange"],
      "cssVarPrefix": "fujin",
      "versionNamespaces": {
        "note": "Fujin carries two independent version identifiers. They are different namespaces and are not comparable.",
        "npmPackage": "package.json `version` / git tags — the distributable artifact version (0.1.0).",
        "raidenEdict": "RAIDEN Edict version recorded in Raiden-ops/state/FLEET_STATUS.md (2.0.0) — the governance control-plane conformance level, not a release of this library."
      },
      "dimensionEncoding": {
        "px": "Emitted to CSS with the `px` unit; emitted to the JS/TS module as a bare number (React inline styles and React Native both want numbers).",
        "em": "Emitted verbatim as a string to both CSS and the JS/TS module (web needs the unit); the native resolver parses the em factor to a number."
      }
    }
  },

  "color": {
    "$type": "color",
    "$description": "Primitive palette. Hues red…orange are Open Color (openColor v1.9). `dark` is Mantine v7's dark ramp, retained because Fujin's dark surfaces were built against it and Open Color has no equivalent neutral. `gray` is Open Color gray.",

    "palette": {
      "$description": "Raw ramps. Index 0 is lightest, 9 is darkest. Never reference these directly from a component — reference a semantic role.",

      "common": {
        "white": { "$value": "#ffffff" },
        "black": { "$value": "#000000" }
      },

      "dark": {
        "$description": "Mantine v7 dark ramp — NOT Open Color.",
        "0": { "$value": "#c9c9c9" },
        "1": { "$value": "#b8b8b8" },
        "2": { "$value": "#828282" },
        "3": { "$value": "#696969" },
        "4": { "$value": "#424242" },
        "5": { "$value": "#3b3b3b" },
        "6": { "$value": "#2e2e2e" },
        "7": { "$value": "#242424" },
        "8": { "$value": "#1f1f1f" },
        "9": { "$value": "#141414" }
      },

