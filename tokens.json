        "1": { "$value": "#f1f3f5" },
        "2": { "$value": "#e9ecef" },
        "3": { "$value": "#dee2e6" },
        "4": { "$value": "#ced4da" },
        "5": { "$value": "#adb5bd" },
        "6": { "$value": "#868e96" },
        "7": { "$value": "#495057" },
        "8": { "$value": "#343a40" },
        "9": { "$value": "#212529" }
      },

      "red": {
