      },

      "teal": {
        "0": { "$value": "#e6fcf5" },
        "1": { "$value": "#c3fae8" },
        "2": { "$value": "#96f2d7" },
        "3": { "$value": "#63e6be" },
        "4": { "$value": "#38d9a9" },
