      },

      "green": {
        "0": { "$value": "#ebfbee" },
        "1": { "$value": "#d3f9d8" },
        "2": { "$value": "#b2f2bb" },
        "3": { "$value": "#8ce99a" },
        "4": { "$value": "#69db7c" },
        "5": { "$value": "#51cf66" },
