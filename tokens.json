        "8": { "$value": "#f08c00" },
        "9": { "$value": "#e67700" }
      },

      "orange": {
        "0": { "$value": "#fff4e6" },
        "1": { "$value": "#ffe8cc" },
        "2": { "$value": "#ffd8a8" },
        "3": { "$value": "#ffc078" },
        "4": { "$value": "#ffa94d" },
        "5": { "$value": "#ff922b" },
        "6": { "$value": "#fd7e14" },
        "7": { "$value": "#f76707" },
        "8": { "$value": "#e8590c" },
        "9": { "$value": "#d9480f" }
      }
    }
  },

  "semantic": {
    "$description": "Mode-scoped semantic roles. These are what components consume — as `var(--fujin-<role-path>)` on web, and as `useTokens().colors.<camelCaseRole>` on native. The accent-derived `interactive.*` roles are authored against the default accent (violet); the build emits per-accent override blocks for the other six accent options.",

    "dark": {
      "$description": "Dark mode (default). CSS: `:root`, or any element carrying the injected variable block.",
      "bg": {
        "$type": "color",
        "base": { "$value": "{color.palette.dark.8}" },
        "surface": { "$value": "{color.palette.dark.7}" },
        "elevated": { "$value": "{color.palette.dark.6}" },
        "overlay": { "$value": "{color.palette.dark.5}" }
      },
      "text": {
        "$type": "color",
        "primary": { "$value": "{color.palette.dark.0}" },
        "secondary": { "$value": "{color.palette.dark.1}" },
        "muted": { "$value": "{color.palette.dark.3}" },
        "inverse": { "$value": "{color.palette.dark.8}" },
        "on-accent": {
          "$value": "{color.palette.common.white}",
          "$description": "Fixed on-accent foreground for text sitting on an `interactive.*` fill. Theme-invariant by design — see OPEN_LOOPS LOOP-006."
        }
      },
      "border": {
        "$type": "color",
        "subtle": { "$value": "{color.palette.dark.6}" },
        "default": { "$value": "{color.palette.dark.5}" },
        "strong": { "$value": "{color.palette.dark.3}" }
      },
      "chrome": {
        "$type": "color",
        "bg": { "$value": "{color.palette.dark.7}" },
        "text": { "$value": "{color.palette.dark.0}" },
        "border": { "$value": "{color.palette.dark.6}" }
      },
      "interactive": {
        "$type": "color",
        "default": { "$value": "{color.palette.violet.6}" },
        "hover": { "$value": "{color.palette.violet.7}" },
        "active": { "$value": "{color.palette.violet.8}" },
        "disabled": { "$value": "{color.palette.dark.5}" }
      },
      "status": {
        "$type": "color",
        "$description": "Accent-preset invariant.",
        "danger": { "$value": "{color.palette.red.6}" },
        "warning": { "$value": "{color.palette.yellow.6}" },
        "success": { "$value": "{color.palette.green.6}" },
        "info": { "$value": "{color.palette.blue.6}" }
      },
      "shadow": {
        "$description": "`xs` is `custom-css` rather than `shadow` because DTCG has no representation for the absence of a shadow.",
        "xs": { "$type": "custom-css", "$value": "none" },
        "sm": { "$type": "shadow", "$value": { "color": "rgba(0,0,0,0.4)", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" } },
        "md": { "$type": "shadow", "$value": { "color": "rgba(0,0,0,0.5)", "offsetX": "0px", "offsetY": "2px", "blur": "4px", "spread": "0px" } },
        "lg": { "$type": "shadow", "$value": { "color": "rgba(0,0,0,0.6)", "offsetX": "0px", "offsetY": "4px", "blur": "8px", "spread": "0px" } },
        "xl": { "$type": "shadow", "$value": { "color": "rgba(0,0,0,0.7)", "offsetX": "0px", "offsetY": "8px", "blur": "16px", "spread": "0px" } }
      },
      "layout": {
        "content-width": {
          "$type": "custom-css",
          "$value": "clamp(560px, 78vw, 2400px)",
          "$description": "Not a plain dimension — a CSS clamp() expression. Web only; the native resolver drops it."
        }
      }
    },

    "light": {
      "$description": "Light mode. CSS: `[data-fujin-mode=\"light\"]` / `.fujin-light`.",
      "bg": {
        "$type": "color",
        "base": { "$value": "{color.palette.gray.3}" },
        "surface": { "$value": "{color.palette.common.white}" },
        "elevated": { "$value": "{color.palette.gray.1}" },
        "overlay": { "$value": "{color.palette.common.white}" }
      },
      "text": {
        "$type": "color",
        "primary": { "$value": "{color.palette.gray.9}" },
        "secondary": { "$value": "{color.palette.gray.7}" },
        "muted": { "$value": "{color.palette.gray.6}" },
        "inverse": { "$value": "{color.palette.gray.0}" },
        "on-accent": {
          "$value": "{color.palette.common.white}",
          "$description": "Fixed on-accent foreground. Same value in both modes on purpose — the accent fill is mode-invariant, so its foreground must be too."
        }
      },
      "border": {
        "$type": "color",
        "subtle": { "$value": "{color.palette.gray.4}" },
        "default": { "$value": "{color.palette.gray.5}" },
        "strong": { "$value": "{color.palette.gray.7}" }
      },
      "chrome": {
        "$type": "color",
        "bg": { "$value": "{color.palette.gray.8}" },
        "text": { "$value": "{color.palette.gray.0}" },
        "border": { "$value": "{color.palette.gray.7}" }
      },
      "interactive": {
        "$type": "color",
        "default": { "$value": "{color.palette.violet.6}" },
        "hover": { "$value": "{color.palette.violet.7}" },
        "active": { "$value": "{color.palette.violet.8}" },
        "disabled": { "$value": "{color.palette.gray.3}" }
      },
      "status": {
        "$type": "color",
        "$description": "Accent-preset invariant.",
        "danger": { "$value": "{color.palette.red.6}" },
        "warning": { "$value": "{color.palette.yellow.6}" },
        "success": { "$value": "{color.palette.green.6}" },
        "info": { "$value": "{color.palette.blue.6}" }
      },
      "shadow": {
        "$description": "`xs` is `custom-css` rather than `shadow` because DTCG has no representation for the absence of a shadow.",
        "xs": { "$type": "custom-css", "$value": "none" },
        "sm": { "$type": "shadow", "$value": { "color": "rgba(0,0,0,0.08)", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" } },
        "md": { "$type": "shadow", "$value": { "color": "rgba(0,0,0,0.12)", "offsetX": "0px", "offsetY": "2px", "blur": "4px", "spread": "0px" } },
        "lg": { "$type": "shadow", "$value": { "color": "rgba(0,0,0,0.16)", "offsetX": "0px", "offsetY": "4px", "blur": "8px", "spread": "0px" } },
        "xl": { "$type": "shadow", "$value": { "color": "rgba(0,0,0,0.2)", "offsetX": "0px", "offsetY": "8px", "blur": "16px", "spread": "0px" } }
      },
      "layout": {
        "content-width": {
          "$type": "custom-css",
          "$value": "clamp(560px, 78vw, 2400px)",
          "$description": "Not a plain dimension — a CSS clamp() expression. Web only; the native resolver drops it."
        }
      }
    }
  },

  "spacing": {
    "$type": "dimension",
    "$description": "4px base grid.",
    "base": { "$value": "4px" },
    "scale": {
      "xxs": { "$value": "2px" },
      "xs": { "$value": "10px" },
      "sm": { "$value": "12px" },
      "md": { "$value": "16px" },
      "lg": { "$value": "20px" },
      "xl": { "$value": "24px" },
      "xxl": { "$value": "32px" }
    }
  },

  "radius": {
    "$type": "dimension",
    "$description": "Fujin is a sharp-edged system. Every radius is 0, at every size. This is a hard rule, not a default — see AGENTS.md and the Mantine hardcoded-radius note in DECISIONS.md.",
    "xs": { "$value": "0px" },
    "sm": { "$value": "0px" },
    "md": { "$value": "0px" },
    "lg": { "$value": "0px" },
    "xl": { "$value": "0px" },
    "default": { "$value": "0px" }
  },

  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "base": { "$value": "\"Verdana\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif" },
      "mono": { "$value": "\"JetBrains Mono\", \"Fira Code\", \"Cascadia Code\", Menlo, Consolas, monospace" }
    },
    "fontSize": {
      "$type": "dimension",
      "xs": { "$value": "10px" },
      "sm": { "$value": "12px" },
      "md": { "$value": "14px" },
      "lg": { "$value": "16px" },
      "xl": { "$value": "20px" },
      "xxl": { "$value": "24px" },
      "h1": { "$value": "32px" },
      "h2": { "$value": "24px" },
      "h3": { "$value": "20px" },
      "h4": { "$value": "16px" },
      "h5": { "$value": "14px" },
      "h6": { "$value": "12px" }
    },
    "fontWeight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "lineHeight": {
      "$type": "number",
      "$description": "Unitless multipliers. Native multiplies by fontSize to get absolute points.",
      "none": { "$value": 1, "$description": "Icon glyphs and single-line badges — suppresses the leading that would otherwise offset the glyph in its box." },
      "tight": { "$value": 1.2 },
      "base": { "$value": 1.5 },
      "relaxed": { "$value": 1.75 }
    },
    "letterSpacing": {
      "$type": "dimension",
      "$description": "em units — emitted as strings, not numbers. Native parses the em factor.",
      "tight": { "$value": "-0.02em" },
      "base": { "$value": "0em" },
      "wide": { "$value": "0.05em" },
      "widest": { "$value": "0.1em" }
    }
  },

  "opacity": {
    "$type": "number",
    "disabled": { "$value": 0.5 },
    "loading": { "$value": 0.7 },
    "muted": { "$value": 0.6, "$description": "Idle state for a chrome-level affordance that should recede until hovered or opened (e.g. the ThemeMenu gear)." }
  },

  "border": {
    "width": {
      "$type": "dimension",
      "hairline": { "$value": "1px", "$description": "Every structural border in the system — panel edges, dividers, table rules." },
      "accent": { "$value": "4px", "$description": "Status-carrying edge stripe (e.g. the leading border on a toast), where the border itself conveys the status colour rather than just bounding the box." }
    }
  },

  "layout": {
    "$type": "dimension",
    "menu-min-width": { "$value": "160px", "$description": "Minimum width for a dropdown/popover panel so short labels do not collapse it." }
  },

  "breakpoints": {
    "$type": "dimension",
    "xs": { "$value": "576px" },
    "sm": { "$value": "768px" },
    "md": { "$value": "992px" },
    "lg": { "$value": "1200px" },
    "xl": { "$value": "1408px" }
  },

  "transition": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "100ms" },
      "base": { "$value": "150ms" },
      "slow": { "$value": "250ms" }
    },
    "easing": {
      "$type": "custom-easing",
      "$description": "CSS easing keywords, kept verbatim rather than expanded to cubicBezier arrays so the emitted CSS matches what was authored.",
      "default": { "$value": "ease" },
      "in": { "$value": "ease-in" },
      "out": { "$value": "ease-out" },
      "inOut": { "$value": "ease-in-out" }
    }
  }
}
